@model IEnumerable<MoviesAdmin.Models.CriticReview>
@{
	ViewData["Title"] = "Critic Reviews";
}

<h1>My Reviews</h1>
<p>
	<a asp-action="Create">Create New Review</a>
</p>
<table class="table">
	<thead>
		<tr>
			<th>Movie</th>
			<th>@Html.DisplayNameFor(model => model.description)</th>
			<th>@Html.DisplayNameFor(model => model.rating)</th>
			<th>@Html.DisplayNameFor(model => model.isPublished)</th>
			<th>@Html.DisplayNameFor(model => model.createdDate)</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item.movie.title</td>
				<td>@Html.DisplayFor(modelItem => item.description)</td>
				<td>@Html.DisplayFor(modelItem => item.rating)</td>
				<td>@getPublishedStatus(item.isPublished)</td>
				<td>@Html.DisplayFor(modelItem => item.createdDate)</td>
				<td>
				@{
					if(!item.isPublished)
					{		
					<a asp-action="Edit" asp-route-id="@item.id">Edit</a>
						<text>|</text>
					<a asp-action="Delete" asp-route-id="@item.id">Delete</a>
						<text>|</text>
					}
				}
					<a asp-action="Details" asp-route-id="@item.id">Details</a>
				</td>
			</tr>
		}
	</tbody>
</table>

@functions {
	public string getPublishedStatus(bool publishedBool)
	{
		if (publishedBool)
		{
			return "Yes";
		}
		return "No";
	}
}