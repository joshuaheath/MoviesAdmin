@model MoviesAdmin.Models.Movie
@using Microsoft.AspNetCore.Html

@{
    ViewData["Title"] = "Details";
}

<h1>Details - @Html.DisplayNameFor(model => model.title)</h1>

<div class="mb-3">
    <img src="@Model.imageUrl" alt="@Model.title" class="detailsView" />
</div>
<div>
    <dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.synopsis)
        </dt>
        <dd class = "col-sm-10">
                @{
                    var descWithBreaks = new HtmlString(
                        Model.synopsis.Replace("\r\n", "<br />")
                            .Replace("\n", "<br />")
                            .Replace("\r", "<br />"));
                }

                @descWithBreaks
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.runtimeMin)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.runtimeMin)
        </dd>

        @* <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.genre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.genre)
        </dd> *@

        @* <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.rating)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.rating)
        </dd> *@

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.releaseDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.releaseDate)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
