@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Create New Movie</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create"  enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="title" class="control-label"></label>
                <input asp-for="title" class="form-control" />
                <span asp-validation-for="title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="runtimeMin" class="control-label"></label>
                <input asp-for="runtimeMin" class="form-control" />
                <span asp-validation-for="runtimeMin" class="text-danger"></span>
            </div>


            <div class="mb-3">
                <label asp-for="synopsis" class="control-label"></label>
                <textarea asp-for="synopsis" class="form-control" rows="5"></textarea>
                <span asp-validation-for="synopsis" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="genreid" class="control-label"></label>
                <select asp-for="genreid" class="form-select" asp-items="ViewBag.genreid"></select>
            </div>

            <div class="mb-3">
                <label asp-for="audienceRatingid" class="control-label"></label>
                <select asp-for="audienceRatingid" class="form-select" asp-items="ViewBag.audienceRatingid"></select>
            </div>

            <div class="mb-3">
                <label for="ImageUpload" class="form-label">Image Upload</label>
                <input type="file" id="ImageUpload" name="ImageUpload" class="form-control"></input>
            </div>



            <div class="mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
