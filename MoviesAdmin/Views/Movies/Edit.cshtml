@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Movie</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="id" />
            <input type="hidden" asp-for="imageUrl" />

            <div class="form-group">
                <img src="@Model.imageUrl" alt="@Model.title" class="detailsView" />
            </div>

            <div class="form-group">
                
                <label asp-for="title" class="control-label"></label>
                <input asp-for="title" class="form-control" />
                <span asp-validation-for="title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="runtimeMin" class="control-label"></label>
                <input asp-for="runtimeMin" class="form-control" />
                <span asp-validation-for="runtimeMin" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="synopsis" class="control-label"></label>
                <textarea asp-for="synopsis" class="form-control" rows="5"></textarea>
                <span asp-validation-for="synopsis" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="imageUrl" class="control-label">Change Image?</label>
                <input type="file" id="ImageUpload" name="ImageUpload" class="form-control"></input>
                <span asp-validation-for="imageUrl" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
